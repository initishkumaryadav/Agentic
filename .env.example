# Copy to .env and fill in. Never commit .env.

# --- SQL Server --------------------------------------------------------------
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
DB_NAME=
SQL_QUERY_TIMEOUT=20

# Read-only login used by the LLM's SQL tool and the fleet dashboard (SELECT on llm_views.Active_FLEET).
SQL_AGENT_USER=fde_agent_ro
SQL_AGENT_PASSWORD=

# Insert-only login used to write the audit trail (INSERT on llm_views.AgentAuditLog).
# Leave empty to disable audit logging. Must be a different login from SQL_AGENT_USER.
SQL_AUDIT_USER=fde_audit_writer
SQL_AUDIT_PASSWORD=

# Read-only login used by the Audit log page (SELECT on llm_views.AgentAuditLog). Created by scripts/security.sql.
SQL_AUDIT_READER_USER=fde_audit_reader
SQL_AUDIT_READER_PASSWORD=

# Admin login: used by scripts/ingest_data.py only. The web app never uses it.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Encrypt traffic to SQL Server. Set SQL_TRUST_SERVER_CERT=no once the server has a CA-signed certificate.
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERT=yes

# --- Reasoning model -----------------------------------------------------------
# OLLAMA | GEMINI | OPENAI
Agent_llm=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings + Pinecone -------------------------------------------------------
# LOCAL | GEMINI | OPENAI. Each provider uses its own index (index-local / index-gemini / index-openai).
# Re-run scripts/ingest_sop_pinecone.py after changing provider or model.
Embeddings_model=LOCAL
Local_Embedding_Model=Qwen/Qwen3-Embedding-4B
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DEVICE=auto
PINECONE_API_KEY=
# PINECONE_INDEX=   # optional override of the index name

# --- App --------------------------------------------------------------------------
# Sign-in is required by default: the app refuses to start unless [auth] is set in .streamlit/secrets.toml.
# Set REQUIRE_AUTH=false only on a developer machine; everyone then shares one "local-dev" identity with admin rights.
REQUIRE_AUTH=true

# Who may use the app once signed in (comma-separated). At least one of the two must be set.
ALLOWED_EMAIL_DOMAINS=yourcompany.com
ALLOWED_EMAILS=
# Who may open the Audit log page (comma-separated emails).
ADMIN_EMAILS=
