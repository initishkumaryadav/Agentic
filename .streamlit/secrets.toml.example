# Copy to .streamlit/secrets.toml (git-ignored) to turn on sign-in.
# Any OpenID Connect provider works: Google, Microsoft Entra ID, Okta, Auth0.
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication

[auth]
redirect_uri = "https://your-domain.example/oauth2callback"   # http://localhost:8501/oauth2callback for local
cookie_secret = "generate-a-long-random-string"               # python -c "import secrets; print(secrets.token_urlsafe(48))"
client_id = ""
client_secret = ""
# Google:     https://accounts.google.com/.well-known/openid-configuration
# Microsoft:  https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
